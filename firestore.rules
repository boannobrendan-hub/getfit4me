rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own profile and subcollections.
    // Subscription fields specifically should ideally only ever be
    // *written* by Cloud Functions (via the Stripe/PayPal webhook and
    // capture handlers, which use the Admin SDK and bypass these rules
    // entirely) — the client-side write in PaywallScreen is for UI
    // responsiveness only. Consider locking subscriptionPlan /
    // subscriptionExpiresAt to be read-only from the client once your
    // webhook flow is fully tested, by splitting them into a separate
    // doc the client cannot write to.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /completions/{completionId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false; // completion records are append-only
      }

      match /feedback/{feedbackId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false; // feedback records are append-only
      }
    }

    // Live trainer alerts are created by Cloud Functions using the Admin
    // SDK (which bypasses these rules), but allow authenticated users to
    // read their own alerts so the app could show "your alert was
    // acknowledged" status if you build that UI later.
    match /liveTrainerAlerts/{alertId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false; // only Cloud Functions (Admin SDK) may write
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
